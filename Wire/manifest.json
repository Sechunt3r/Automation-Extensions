{
  "manifest_version": 3,
  "name": "Wire - FinSMEs Article Collector",
  "version": "1.2.1",
  "description": "Collect and deduplicate FinSMEs article URLs across any date range, then export to CSV or JSON. Runs in your browser; no data leaves it.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Wire - FinSMEs Article Collector",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.finsmes.com/*"
  ],
  "minimum_chrome_version": "116"
}
